# Callytics configuration. Every value is read through callytics/settings.py.
# Copy to .env for local development; production reads /etc/callytics/callytics.env

CALLYTICS_ENV=dev
CALLYTICS_TIMEZONE=Asia/Kolkata

# --- storage --------------------------------------------------------------
# Dev/test default is SQLite; production is MySQL.
CALLYTICS_MYSQL_DSN=mysql+pymysql://callytics:CHANGEME@127.0.0.1:3306/callytics
CALLYTICS_MYSQL_POOL_SIZE=5

# --- event bus ------------------------------------------------------------
CALLYTICS_BROKER=memory            # memory|kafka
CALLYTICS_KAFKA_BOOTSTRAP=127.0.0.1:9092
CALLYTICS_TOPIC_PREFIX=callytics

# --- api ------------------------------------------------------------------
CALLYTICS_API_HOST=127.0.0.1
CALLYTICS_API_PORT=8080
# Shared service token. The API refuses to serve requests if this is unset.
CALLYTICS_API_TOKEN=
CALLYTICS_CORS_ORIGINS=

# --- FinEcho (conversation intelligence) ----------------------------------
CALLYTICS_FINECHO_URL=http://127.0.0.1:8090
CALLYTICS_FINECHO_TOKEN=
# HMAC-SHA256 secret for the inbound call webhook. Required.
CALLYTICS_FINECHO_WEBHOOK_SECRET=
CALLYTICS_FINECHO_TIMEOUT_S=30

# --- LeadSquared (read-only: migration + dual-run reconciliation) ---------
CALLYTICS_LSQ_BASE_URL=https://api-in21.leadsquared.com/v2
CALLYTICS_LSQ_ACCESS_KEY=
CALLYTICS_LSQ_SECRET_KEY=
CALLYTICS_LSQ_RATE_PER_MIN=50

# --- ad-audience sync -----------------------------------------------------
CALLYTICS_AUDIENCE_SYNC_ENABLED=false
CALLYTICS_META_AD_ACCOUNT_ID=
CALLYTICS_META_ACCESS_TOKEN=
CALLYTICS_GOOGLE_CUSTOMER_ID=
CALLYTICS_GOOGLE_DEVELOPER_TOKEN=

# --- intelligence tuning --------------------------------------------------
# Off by default: every inferred stage change waits for a human decision.
CALLYTICS_STAGE_PROPOSAL_AUTO_APPLY=false
CALLYTICS_STAGE_PROPOSAL_MIN_CONFIDENCE=0.80
CALLYTICS_SCORE_HALF_LIFE_DAYS=14
CALLYTICS_WORKING_HOURS_START=9
CALLYTICS_WORKING_HOURS_END=20
